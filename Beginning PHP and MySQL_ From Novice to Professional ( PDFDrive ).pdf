      <rdf:Description rdf:about=""
            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
            xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#">
         <xmpMM:DocumentID>uuid:9b223e6d-571e-4b39-8fa1-f47d27b642f2</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:bad92ae0-b2b8-4ebf-a957-737ddd27fb9f</xmpMM:InstanceID>
